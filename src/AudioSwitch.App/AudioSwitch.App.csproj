<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>Assets\AudioSwitch.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <!-- The commit and build time are added as assembly metadata below; keep the informational version short. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Publishing produces one uncompressed exe: compression halves the file but doubles the memory of this resident app. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <Target Name="AddBuildInformation" BeforeTargets="GetAssemblyAttributes">
    <!-- Without git or outside a repository the commands fail; their error text must not become the version text. -->
    <Exec Command="git rev-parse --short HEAD 2&gt;nul" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="BuildCommit" />
      <Output TaskParameter="ExitCode" PropertyName="BuildCommitExitCode" />
    </Exec>
    <Exec Command="git status --porcelain 2&gt;nul" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="BuildWorkingTreeChanges" />
      <Output TaskParameter="ExitCode" PropertyName="BuildStatusExitCode" />
    </Exec>
    <ItemGroup>
      <AssemblyMetadata Include="BuildCommit" Value="$(BuildCommit)" Condition="'$(BuildCommitExitCode)' == '0'" />
      <AssemblyMetadata Include="BuildHasLocalChanges" Value="true"
                        Condition="'$(BuildStatusExitCode)' == '0' and '$(BuildWorkingTreeChanges)' != ''" />
      <AssemblyMetadata Include="BuildTime" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- WPF and WinForms share many type names; WinForms is only used through explicit aliases. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\AudioSwitch.ico" />
    <Resource Include="Assets\AudioSwitch.Tray.Dark.ico" />
    <Resource Include="Assets\AudioSwitch.Tray.Light.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AudioSwitch.Core\AudioSwitch.Core.csproj" />
    <ProjectReference Include="..\AudioSwitch.Platform.Windows\AudioSwitch.Platform.Windows.csproj" />
    <ProjectReference Include="..\AudioSwitch.Presentation\AudioSwitch.Presentation.csproj" />
  </ItemGroup>
</Project>
