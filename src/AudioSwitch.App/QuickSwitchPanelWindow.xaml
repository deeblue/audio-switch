<Window x:Class="AudioSwitch.App.QuickSwitchPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioSwitch" Width="360" Height="420" MaxHeight="560"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Window.Resources>
    <ResourceDictionary Source="/AudioSwitch.App;component/Views/AppStyles.xaml"/>
  </Window.Resources>
  <Border x:Name="RootBorder" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1" Padding="12,12,4,12">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="4,0,8,8">
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="設定" AutomationProperties.Name="設定">
          <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE713;"/>
        </Button>
        <TextBlock Text="AudioSwitch" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" VerticalAlignment="Center"/>
      </DockPanel>
      <TabControl x:Name="FlowTabs" DockPanel.Dock="Top" SelectionChanged="Flow_SelectionChanged" Margin="0,0,8,0">
        <TabItem Header="播放" Tag="Render"/>
        <TabItem Header="錄音" Tag="Capture"/>
      </TabControl>
      <StackPanel DockPanel.Dock="Bottom" Margin="4,8,8,0">
        <TextBlock x:Name="UnconfiguredNotice" Style="{StaticResource CaptionText}" Visibility="Collapsed">
          <Run Text="有 USB 裝置還沒對應到接口。"/>
          <Hyperlink Click="Configure_Click">設定接口</Hyperlink>
        </TextBlock>
        <TextBlock x:Name="StatusText" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
      </StackPanel>
      <Grid Margin="0,8,0,0">
        <ScrollViewer x:Name="GroupsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="GroupsList" Margin="0,0,12,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" Margin="8,4,8,4" TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap"/>
                  <ItemsControl ItemsSource="{Binding Endpoints}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Button Click="Endpoint_Click" Tag="{Binding EndpointId}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Height="36" Padding="8,0" AutomationProperties.Name="{Binding Name}">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                              </Style>
                            </Button.Style>
                            <DockPanel>
                              <Grid DockPanel.Dock="Left" Width="20" Margin="0,0,8,0">
                                <TextBlock x:Name="DefaultMark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"
                                           Visibility="Collapsed" ToolTip="目前預設" AutomationProperties.Name="目前預設"/>
                              </Grid>
                              <TextBlock x:Name="EndpointName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                         VerticalAlignment="Center"/>
                            </DockPanel>
                          </Button>
                          <Button x:Name="ToneButton" Grid.Column="1" Tag="{Binding EndpointId}" Click="Tone_Click" Margin="4,0,0,0"
                                  Style="{StaticResource IconButton}" ToolTip="試音" AutomationProperties.Name="試音" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE767;"/>
                          </Button>
                        </Grid>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsDefault}" Value="True">
                            <Setter TargetName="DefaultMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="EndpointName" Property="FontWeight" Value="SemiBold"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Flow}" Value="Render">
                            <Setter TargetName="ToneButton" Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="EmptyText" Text="目前沒有可用的音訊裝置。" Style="{StaticResource SecondaryText}" Margin="8,24,16,24"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
    </DockPanel>
  </Border>
</Window>
