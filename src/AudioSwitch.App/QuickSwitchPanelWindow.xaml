<Window x:Class="AudioSwitch.App.QuickSwitchPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioSwitch" Width="380" Height="520" MinWidth="320" MinHeight="360"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
  <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Padding="14">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top">
        <DockPanel Margin="0,0,0,10">
          <Button DockPanel.Dock="Right" Content="⚙" Width="34" Height="30" Click="Settings_Click" ToolTip="設定"/>
          <TextBlock Text="AudioSwitch" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <TabControl SelectionChanged="Flow_SelectionChanged" x:Name="FlowTabs">
          <TabItem Header="播放" Tag="Render"/>
          <TabItem Header="錄音" Tag="Capture"/>
        </TabControl>
      </StackPanel>
      <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <TextBlock x:Name="StatusText" Foreground="Firebrick" TextWrapping="Wrap"/>
        <Button x:Name="ConfigureButton" DockPanel.Dock="Right" Content="設定接口…" Padding="8,4" Click="Configure_Click" Visibility="Collapsed"/>
      </DockPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
        <StackPanel>
        <TextBlock x:Name="PeakText" Margin="2,0,2,8" Visibility="Collapsed"/>
        <ItemsControl x:Name="GroupsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,4"/>
                <ItemsControl ItemsSource="{Binding Endpoints}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,1">
                        <Button DockPanel.Dock="Right" Content="試音" Tag="{Binding EndpointId}" Click="Tone_Click" Padding="6,2">
                          <Button.Style>
                            <Style TargetType="Button">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Flow}" Value="Render"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Click="Endpoint_Click" Tag="{Binding EndpointId}" HorizontalContentAlignment="Stretch" Padding="8,7">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text=" " Width="22">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Text" Value=""/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDefault}" Value="True"><Setter Property="Text" Value="✓"/></DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                          </DockPanel>
                        </Button>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
