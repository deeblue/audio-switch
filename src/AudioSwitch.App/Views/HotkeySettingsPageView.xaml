<UserControl x:Class="AudioSwitch.App.Views.HotkeySettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:AudioSwitch.App">
  <UserControl.Resources>
    <ResourceDictionary Source="/AudioSwitch.App;component/Views/AppStyles.xaml"/>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
    <StackPanel Width="560" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{app:Loc '快捷鍵'}" Style="{StaticResource SectionTitle}" Margin="0"/>
          <TextBlock Text="{app:Loc '點欄位後按下組合鍵（例如 Ctrl + Alt + F1）。每按一次就切換到下一個可用的裝置。'}"
                     Style="{StaticResource CaptionText}" Margin="0,4,0,12"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="240"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="8"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{app:Loc '切換播放裝置'}" VerticalAlignment="Center"/>
            <TextBox x:Name="PlaybackHotkeyBox" Grid.Column="1" IsReadOnly="True" AutomationProperties.Name="{app:Loc '切換播放裝置的快捷鍵'}"
                     Text="{Binding PlaybackHotkey, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="ClearPlayback_Click" Margin="8,0,0,0"
                    ToolTip="{app:Loc '清除'}" AutomationProperties.Name="{app:Loc '清除播放快捷鍵'}">
              <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE894;"/>
            </Button>
            <TextBlock Grid.Row="2" Text="{app:Loc '切換錄音裝置'}" VerticalAlignment="Center"/>
            <TextBox x:Name="RecordingHotkeyBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" AutomationProperties.Name="{app:Loc '切換錄音裝置的快捷鍵'}"
                     Text="{Binding RecordingHotkey, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource IconButton}" Click="ClearRecording_Click" Margin="8,0,0,0"
                    ToolTip="{app:Loc '清除'}" AutomationProperties.Name="{app:Loc '清除錄音快捷鍵'}">
              <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE894;"/>
            </Button>
          </Grid>
          <Button Content="{app:Loc '套用'}" Style="{StaticResource PrimaryButton}" Click="Apply_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
          <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                     Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhenNotNull}}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
