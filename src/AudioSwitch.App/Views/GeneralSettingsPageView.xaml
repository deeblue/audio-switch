<UserControl x:Class="AudioSwitch.App.Views.GeneralSettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ResourceDictionary Source="/AudioSwitch.App;component/Views/AppStyles.xaml"/>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
    <StackPanel Width="560" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <CheckBox Content="登入 Windows 時啟動 AudioSwitch" IsChecked="{Binding AutostartEnabled, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                     Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhenNotNull}}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="IdentifyScreens_Click" VerticalAlignment="Center" Margin="16,0,0,0"
                  ToolTip="識別螢幕" AutomationProperties.Name="識別螢幕">
            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7F4;"/>
          </Button>
          <StackPanel>
            <TextBlock Text="識別螢幕"/>
            <TextBlock Text="在每個螢幕上顯示編號，方便對照裝置頁的螢幕。" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
